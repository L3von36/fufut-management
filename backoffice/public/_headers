# Same scheme as pos/public/_headers. The backoffice has no service worker,
# so these headers are the only cache policy the app gets — which is exactly
# why the shell must be no-store here: a stale shell requests asset hashes a
# later deploy has removed, and with 404.html present Pages answers that with
# a real 404 instead of the MIME-type failure a 200-HTML fallback produced.
/*
  Cache-Control: no-store

# Hashed assets are immutable — a new build produces a new filename, so these
# can be cached hard and forever. (Later rule wins for the same header.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
