# Missing hashed assets must 404 rather than fall through to the app shell:
# the shell is HTML with a long max-age, so browsers cached it under .css/.js
# URLs and the Tables route's dynamic import rejected on it.
#
# This rule has to come first — the catch-all below would otherwise match.
/assets/*  /404.html  404

# Client-side routing. Scoping this to /pos/* instead did not match in Pages and
# 404'd every app route, so it stays a catch-all with /assets/* carved out above.
/*  /index.html  200
